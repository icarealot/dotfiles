{
  "name": "icarealot-pi-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pi coding-agent extensions",
  "keywords": ["pi-package"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./ai/pi/custom-footer/index.ts",
      "./ai/pi/notify/index.ts",
      "./ai/pi/subagent/index.ts",
      "./ai/pi/web/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
